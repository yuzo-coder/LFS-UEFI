#!/bin/bash
set -euo pipefail

PARTITION="nbd0p2"
DISK=$(echo "$PARTITION" | sed -E 's/(p[0-9]+|[0-9]+)$//')

########################################
# root実行禁止
########################################
if [ "$(id -u)" -eq 0 ]; then
    echo "Do NOT run this script as root."
    exit 1
fi

########################################
# 安全な基準ディレクトリ確定
########################################
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

########################################
# 設定読み込み
########################################
. config/config.sh
. data/configparser.sh

BUILD_DIR="$SCRIPT_DIR/build"
SRC_DIR="$SCRIPT_DIR/src/packages"
LFS="$BUILD_DIR/builddir"

echo -e "\nPreparing for building $LFS_TARGET_ARCH disk image...\n"

########################################
# build ディレクトリ初期化
########################################
mkdir -p "$BUILD_DIR"

########################################
# build 完全初期化（中身だけ削除）
########################################
echo -e "\nCleaning build directory...\n"
rm -rf "${BUILD_DIR:?}/"*
mkdir -p "$BUILD_DIR"

########################################
# スクリプトコピー
########################################
cp -rv data/stages/* "$BUILD_DIR/"
cp -rv data/scripts "$BUILD_DIR/"


if [[ "$LFS_TARGET_INIT" == "sysv" ]]; then
    cp -rv data/cscripts.sysv "$BUILD_DIR/cscripts"
fi

if [[ "$LFS_TARGET_INIT" == "systemd" ]]; then
    cp -rv data/cscripts.systemd "$BUILD_DIR/cscripts"
fi

########################################
# env.sh
########################################
cat > "$BUILD_DIR/env.sh" << EOF
LFS="$LFS"
MAKEFLAGS="-j$(nproc)"
PARTITION="$PARTITION"
DISK="$DISK"
export LFS MAKEFLAGS PARTITION DISK
EOF

########################################
# userenv.sh
########################################
if [[ "$LFS_TARGET_ARCH" == "amd64" ]]; then
    LFS_TGT='$(uname -m)-lfs-linux-gnu'
else
    LFS_TGT="$LFS_TARGET_ARCH-lfs-linux-gnu"
fi

cat > "$BUILD_DIR/userenv.sh" << EOF
. ./env.sh
set +h
umask 022
LC_ALL=POSIX
LFS_TGT=$LFS_TGT
PATH=/usr/bin
[ ! -L /bin ] && PATH=/bin:\$PATH
PATH=\$LFS/tools/bin:\$PATH
CONFIG_SITE=\$LFS/usr/share/config.site
export LFS LC_ALL LFS_TGT PATH CONFIG_SITE
EOF

########################################
# cscripts.config
########################################
mkdir -p "$BUILD_DIR/cscripts.config"

cat > "$BUILD_DIR/cscripts.config/config.sh" << EOF
ULFS_TESTS="NO"
ULFS_CRITICAL_TESTS="NO"
ULFS_DOCS="NO"
ULFS_COPY_KERNEL_SOURCES="YES"
MAKEFLAGS="-j$(nproc)"
NINJAJOBS=$(nproc)
EOF

cat > "$BUILD_DIR/cscripts.config/env.sh" << EOF
. /cscripts/config.sh
PATH=/usr/bin:/usr/sbin
LC_ALL=POSIX
LFS_TGT=$LFS_TGT
LANG=C
export PATH LANG ULFS_TESTS ULFS_CRITICAL_TESTS ULFS_DOCS ULFS_COPY_KERNEL_SOURCES NINJAJOBS MAKEFLAGS LFS_TGT
EOF

########################################
# ソースリンク
########################################
ln -sfn ../src/packages "$BUILD_DIR/src"

########################################
# 必須ディレクトリ
########################################
mkdir -p "$LFS" "$BUILD_DIR/log" "$BUILD_DIR/tmp" "$LFS/tools"

########################################
# 権限
########################################
chmod 755 "$LFS" "$BUILD_DIR/log" "$BUILD_DIR/tmp"
chmod 755 "$BUILD_DIR/env.sh" "$BUILD_DIR/userenv.sh"
chmod 755 "$BUILD_DIR/cscripts.config/"*.sh

echo -e "\nBuild directory initialized successfully.\n"
echo "DISK = $DISK"
echo "PARTITION = $PARTITION"
echo "LFS = $LFS"
