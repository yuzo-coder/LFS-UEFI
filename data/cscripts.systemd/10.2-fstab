cat > /etc/fstab << "EOF"
# Begin /etc/fstab

# file system  mount-point  type     options             dump  fsck
#                                                              order

/dev/sda1       /boot/efi       vfat    defaults

/dev/sda2       /       ext4    defaults

/swapfile     swap         swap     pri=1               0     0

# End /etc/fstab

EOF
