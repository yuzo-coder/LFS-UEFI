# grub-install --target=i386-pc /dev/nbd0

grub-install --target=x86_64-efi --efi-directory=/boot/efi --boot-directory=/boot --bootloader-id=LFS --removable

#cd /tmp
#grub-mkrescue --output=grub-img.iso
#xorriso -as cdrecord -v dev=/dev/cdrw blank=as_needed grub-img.iso

LC_ALL=C grub-mkconfig -o /boot/grub/grub.cfg

sed -i 's|/dev/nbd0p2|/dev/sda2|g' /boot/grub/grub.cfg

sed -i '/load_video/a \	insmod search_fs_uuid' /boot/grub/grub.cfg

mkdir -p /boot/efi/EFI/BOOT

cp -fv /boot/grub/grub.cfg /boot/efi/EFI/BOOT/grub.cfg

