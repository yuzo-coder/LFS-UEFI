. /cscripts/env.sh

cd /sources

rm -rfv linux-6.16.1

tar -xf linux-6.16.1.tar.xz

#if [[ "$ULFS_COPY_KERNEL_SOURCES" == "YES" ]]
#then
#    cp -rv linux-6.16.1 /usr/src
#fi

cd linux-6.16.1

#FORCING ARCH 
#ARCH=""

#make mrproper

cp -f /BLFS/.config /sources/linux-6.16.1/

# 依存関係自動解決
make olddefconfig

# ---------- ここまで追加 ----------

echo 'make -j$(nproc)' >> kernelbuilder

echo 'make modules_install'>> kernelbuilder

chmod +x kernelbuilder

cat kernelbuilder

./kernelbuilder

cp -fv arch/x86/boot/bzImage /boot/vmlinuz-6.16.1-lfs-12.4-systemd

cp -fv System.map /boot/System.map-6.16.1

cp -fv .config /boot/config-6.16.1

if [[ "$ULFS_DOCS" == "YES" ]]
then

cp -r Documentation -T /usr/share/doc/linux-6.16.1

fi

install -v -m755 -d /etc/modprobe.d
cat > /etc/modprobe.d/usb.conf << "EOF"
# Begin /etc/modprobe.d/usb.conf

install ohci_hcd /sbin/modprobe ehci_hcd ; /sbin/modprobe -i ohci_hcd ; true
install uhci_hcd /sbin/modprobe ehci_hcd ; /sbin/modprobe -i uhci_hcd ; true

# End /etc/modprobe.d/usb.conf
EOF

